# Git ignore rules (standard)
.git/
.github/
.vscode/
.dart_tool/
pubspec.lock

# Workspace child packages (published independently)
libraries/
packages/

# Monorepo tooling and sample applications
builder/
sample_projects/
tool/

# Build artifacts (ignore build outputs but keep build folders in lib/)
**/build/
!**/lib/**/build/
!**/lib/**/build/**
!lib/**/build/
!lib/**/build/**

# Jetleaf AOT caches & build outputs
.jetleaf/
_jetleaf/
*.bin
*.info.json
*.log
.env*